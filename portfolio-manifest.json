{
  "schema_version": 1,
  "project": "DAOUTECH_IDC",
  "description": "IDC operation automation and simulation portfolio submission manifest",
  "runtime": {
    "python": ">=3.12",
    "node": ">=24",
    "third_party_python_packages": false
  },
  "submission_required": [
    "README.md",
    "SUBMISSION.md",
    "LICENSE",
    "requirements.txt",
    "portfolio-manifest.json",
    ".github/workflows/summary.yml",
    ".github/dependabot.yml",
    "tools/review_repo.py",
    "tools/run_analyze.py",
    "noc-dashboard.html",
    "healthcheck.py",
    "check.json",
    "log_analyzer.py",
    "disk_forecast.py",
    "svc_watchdog.py",
    "backup_verify.py",
    "cert_expiry.py",
    "domains.txt",
    "linux-security-lab.html",
    "backup-simulator.html",
    "incident-lab.html",
    "server-console.html",
    "network-path.html"
  ],
  "generated_reports": [
    "review.md",
    "review.json",
    "execution-report.md",
    "execution-report.json",
    "prompt.txt"
  ],
  "files": [
    {"path": "README.md", "category": "documentation", "purpose": "포트폴리오 목적, 구성, 실행 및 검증 방법 안내"},
    {"path": "SUBMISSION.md", "category": "documentation", "purpose": "채용 제출 전 체크와 검토 순서 안내"},
    {"path": "LICENSE", "category": "legal", "purpose": "저장소 라이선스 조건"},
    {"path": "requirements.txt", "category": "runtime", "purpose": "외부 Python 의존성이 없음을 명시"},
    {"path": "portfolio-manifest.json", "category": "manifest", "purpose": "파일별 역할과 제출 필수 파일의 기준"},
    {"path": ".github/workflows/summary.yml", "category": "ci", "purpose": "전체 검수, 실행 분석, AI 요약 및 Artifact 생성"},
    {"path": ".github/dependabot.yml", "category": "dependency-automation", "purpose": "GitHub Actions와 Python 의존성을 주기적으로 확인하고 업데이트 PR 생성"},
    {"path": ".gitignore", "category": "repository", "purpose": "생성 리포트와 배포 압축물 등 비소스 파일 제외"},
    {"path": "tools/review_repo.py", "category": "quality", "purpose": "구조·문법·README 경로·Node 호환성을 결정적으로 검사"},
    {"path": "tools/run_analyze.py", "category": "quality", "purpose": "모든 Git 추적 파일을 안전하게 실행·분석하고 제출 준비도를 판정"},
    {"path": "noc-dashboard.html", "category": "simulator", "purpose": "IDC 랙·장비·포트·환경 상태 관제 시뮬레이터"},
    {"path": "healthcheck.py", "category": "python-cli", "purpose": "서버 CPU·메모리·디스크·서비스·네트워크 상태 점검"},
    {"path": "check.json", "category": "config", "purpose": "서버 헬스체크 임계치와 대상 설정"},
    {"path": "log_analyzer.py", "category": "python-cli", "purpose": "로그 정규화·오류 집계·급증 구간 분석"},
    {"path": "disk_forecast.py", "category": "python-cli", "purpose": "디스크 사용 추세와 임계치 도달 시점 예측"},
    {"path": "svc_watchdog.py", "category": "python-cli", "purpose": "서비스 정지 감지와 제한적 재기동 정책 구현"},
    {"path": "backup_verify.py", "category": "python-cli", "purpose": "백업 존재·크기·신선도·SHA-256 검증"},
    {"path": "cert_expiry.py", "category": "python-cli", "purpose": "TLS 인증서 만료 사전 점검"},
    {"path": "domains.txt", "category": "input", "purpose": "인증서 만료 점검 대상 목록"},
    {"path": "linux-security-lab.html", "category": "simulator", "purpose": "Linux 권한·로그·방화벽 정책 검토 실습"},
    {"path": "backup-simulator.html", "category": "simulator", "purpose": "백업 스케줄·복구 체인·장애 주입 시뮬레이션"},
    {"path": "incident-lab.html", "category": "simulator", "purpose": "IDC 장애 조사·원인·조치·보고 흐름 실습"},
    {"path": "server-console.html", "category": "simulator", "purpose": "장애 상태와 서버 명령 출력의 연동 실습"},
    {"path": "network-path.html", "category": "simulator", "purpose": "네트워크 구간별 장애 원인 진단 실습"}
  ]
}
